{
  "index_patterns": ["security-linux-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "event": {
          "properties": {
            "action": { "type": "keyword" },
            "category": { "type": "keyword" },
            "type": { "type": "keyword" }
          }
        },
        "process": {
          "properties": {
            "name": { "type": "keyword" },
            "executable": { "type": "keyword" },
            "command_line": { "type": "wildcard" },
            "pid": { "type": "long" },
            "parent": {
              "properties": {
                "pid": { "type": "long" },
                "executable": { "type": "keyword" }
              }
            }
          }
        }
      }
    }
  }
}
